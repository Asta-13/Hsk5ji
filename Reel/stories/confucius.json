 "title_zh": "孔子",
 "title_mn": "Күнз (Конфуци)",
 "lines": [
  {
   "scene": "t1",
   "zh": "孔子是两千五百年前的老师和思想家。",
   "mn": "Күнз бол хоёр мянга таван зуун жилийн өмнөх багш, сэтгэгч."
  },
  {
   "scene": "t1",
   "zh": "传说他有三千个学生。",
   "mn": "Домогт өгүүлснээр түүнд гурван мянган шавь байжээ."
  },
  {
   "scene": "ic",
   "zh": "他说：“学了以后，要常常复习。”",
   "mn": "Тэрээр «Сурсныхаа дараа байнга давтах хэрэгтэй» гэж хэлсэн."
  },
  {
   "scene": "ic",
   "zh": "他还说：“三个人一起走，一定有我的老师。”",
   "mn": "Мөн «Гурван хүн хамт явбал, заавал миний багш байна» гэж хэлсэн."
  },
  {
   "scene": "ic",
   "zh": "他的话被写进了《论语》。",
   "mn": "Түүний үгс «Луньюй» номд бичигдсэн."
  },
  {
   "scene": "t2",
   "zh": "他认为，每个人都可以学习。",
   "mn": "Тэрээр хүн бүр суралцаж болно гэж үздэг байв."
  },
  {
   "scene": "t2",
   "zh": "这个想法影响了中国的教育。",
   "mn": "Энэ үзэл Хятадын боловсролд нөлөөлсөн."
  }
 ],
