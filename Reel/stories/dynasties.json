 "title_zh": "中国的朝代",
 "title_mn": "Хятадын гүрнүүд",
 "lines": [
  {
   "scene": "t1",
   "zh": "中国历史上有很多朝代。",
   "mn": "Хятадын түүхэнд олон гүрэн улс оршин тогтнож байсан."
  },
  {
   "scene": "t1",
   "zh": "秦朝统一了中国，后来是汉朝。",
   "mn": "Цинь улс Хятадыг нэгтгэсэн бөгөөд дараа нь Хань улс болсон."
  },
  {
   "scene": "ic",
   "zh": "汉朝开通了丝绸之路。",
   "mn": "Хань улс Торгоны замыг нээсэн."
  },
  {
   "scene": "ic",
   "zh": "唐朝的诗歌最有名。",
   "mn": "Тан улсын шүлэг хамгийн алдартай."
  },
  {
   "scene": "ic",
   "zh": "宋朝有很多发明和商业。",
   "mn": "Сун улсад олон шинэ бүтээл, худалдаа цэцэглэсэн."
  },
  {
   "scene": "ic",
   "zh": "明朝修了故宫，也修了长城。",
   "mn": "Мин улс Гугун болон Цагаан хэрмийг барьсан."
  },
  {
   "scene": "t2",
   "zh": "最后一个朝代是清朝，1912年结束。",
   "mn": "Сүүлчийн гүрэн бол Чин улс бөгөөд 1912 онд дууссан."
  }
 ],
