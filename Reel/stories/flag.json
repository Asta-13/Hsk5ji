 "title_zh": "中国的国旗",
 "title_mn": "Хятадын төрийн далбаа",
 "lines": [
  {
   "scene": "t1",
   "zh": "中国的国旗叫五星红旗。",
   "mn": "Хятадын төрийн далбааг «Таван одот улаан туг» гэдэг."
  },
  {
   "scene": "t1",
   "zh": "旗是红色的，上面有五颗黄色的星。",
   "mn": "Туг улаан өнгөтэй, дээр нь таван шар од бий."
  },
  {
   "scene": "ic",
   "zh": "红色代表革命，黄色代表光明。",
   "mn": "Улаан өнгө хувьсгалыг, шар өнгө гэрэл гэгээг төлөөлдөг."
  },
  {
   "scene": "ic",
   "zh": "国歌是《义勇军进行曲》。",
   "mn": "Төрийн дуулал нь «Сайн дурын армийн марш»."
  },
  {
   "scene": "ic",
   "zh": "国旗在1949年开始使用。",
   "mn": "Төрийн далбаа 1949 оноос хэрэглэгдэж эхэлсэн."
  },
  {
   "scene": "t2",
   "zh": "每天早上，天安门广场都有升旗仪式。",
   "mn": "Өглөө бүр Тяньаньмэний талбайд туг мандуулах ёслол болдог."
  },
  {
   "scene": "t2",
   "zh": "很多人专门去北京看升旗。",
   "mn": "Олон хүн туг мандуулахыг үзэхээр Бээжин явдаг."
  }
 ],
