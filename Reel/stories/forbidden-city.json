 "title_zh": "故宫",
 "title_mn": "Гугун (Хориотой хот)",
 "lines": [
  {
   "scene": "t1",
   "zh": "故宫在北京，是明朝和清朝的皇宫。",
   "mn": "Гугун Бээжинд байх бөгөөд Мин, Чин улсын эзэн хааны ордон байв."
  },
  {
   "scene": "t1",
   "zh": "它是明朝皇帝建造的。",
   "mn": "Үүнийг Мин улсын эзэн хаан барьсан."
  },
  {
   "scene": "tl",
   "zh": "它建于1406年，一共用了十四年。",
   "mn": "Энэ нь 1406 онд барьж эхэлсэн бөгөөд нийт арван дөрвөн жил болсон."
  },
  {
   "scene": "tl",
   "zh": "这里先后住过二十四位皇帝。",
   "mn": "Энд дараалан хорин дөрвөн эзэн хаан амьдарсан."
  },
  {
   "scene": "ic",
   "zh": "故宫有红色的墙和黄色的瓦。",
   "mn": "Гугунд улаан хана, шар ваар бий."
  },
  {
   "scene": "t2",
   "zh": "1925年，故宫成了博物馆。",
   "mn": "1925 онд Гугун музей болсон."
  },
  {
   "scene": "t2",
   "zh": "每年有很多人来这里参观。",
   "mn": "Жил бүр олон хүн энд үзэж танилцахаар ирдэг."
  }
 ],
