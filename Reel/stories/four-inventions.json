 "level": 4,
 "title_zh": "中国的四大发明",
 "title_mn": "Хятадын дөрвөн их шинэ бүтээл",
 "lines": [
  {
   "scene": "t1",
   "zh": "中国古代有四大发明。",
   "mn": "Эртний Хятадад дөрвөн их шинэ бүтээл байсан."
  },
  {
   "scene": "ic",
   "zh": "它们是造纸术、印刷术、火药和指南针。",
   "mn": "Тэдгээр нь цаас хийх арга, хэвлэх арга, дарь, луужин юм."
  },
  {
   "scene": "ic",
   "zh": "纸和印刷术让知识传得更远。",
   "mn": "Цаас, хэвлэх арга нь мэдлэгийг илүү холд түгээсэн."
  },
  {
   "scene": "ic",
   "zh": "印刷术让书越来越多，越来越便宜。",
   "mn": "Хэвлэх арга нь номыг улам олон, улам хямд болгосон."
  },
  {
   "scene": "ic",
   "zh": "火药后来也传到了世界各地。",
   "mn": "Дарь хожим дэлхийн өнцөг бүрт тархсан."
  },
  {
   "scene": "ic",
   "zh": "指南针帮助人们在海上找到方向。",
   "mn": "Луужин нь хүмүүст далайд чиглэлээ олоход тусалсан."
  },
  {
   "scene": "t2",
   "zh": "这些发明改变了世界。",
   "mn": "Эдгээр шинэ бүтээл дэлхийг өөрчилсөн."
  }
 ],
