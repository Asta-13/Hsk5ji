 "title_zh": "高考",
 "title_mn": "Гаокао — их сургуулийн элсэлтийн шалгалт",
 "lines": [
  {
   "scene": "t1",
   "zh": "高考是中国高中生上大学的考试。",
   "mn": "Гаокао бол Хятадын ахлах ангийн сурагчдын их сургуульд орох шалгалт."
  },
  {
   "scene": "t1",
   "zh": "每年六月七日，考试开始。",
   "mn": "Жил бүрийн 6-р сарын 7-нд шалгалт эхэлдэг."
  },
  {
   "scene": "tn",
   "zh": "每年有一千多万学生参加。",
   "mn": "Жил бүр арав гаруй сая сурагч оролцдог."
  },
  {
   "scene": "ic",
   "zh": "考试要考语文、数学和外语。",
   "mn": "Хятад хэл, математик, гадаад хэлний шалгалт өгдөг."
  },
  {
   "scene": "ic",
   "zh": "学生们要复习很长时间。",
   "mn": "Сурагчид удаан хугацаанд давтдаг."
  },
  {
   "scene": "t2",
   "zh": "考试的时候，家长在外面等。",
   "mn": "Шалгалтын үеэр эцэг эх гадаа хүлээдэг."
  },
  {
   "scene": "t2",
   "zh": "高考对很多家庭来说非常重要。",
   "mn": "Гаокао олон гэр бүлийн хувьд маш чухал."
  }
 ],
