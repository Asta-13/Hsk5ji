 "title_zh": "长城",
 "title_mn": "Цагаан хэрэм",
 "lines": [
  {
   "scene": "t1",
   "zh": "长城是中国古代最有名的建筑之一。",
   "mn": "Цагаан хэрэм бол эртний Хятадын хамгийн алдартай барилгуудын нэг."
  },
  {
   "scene": "t1",
   "zh": "两千多年前，秦朝把北方的城墙连了起来。",
   "mn": "Хоёр мянга гаруй жилийн өмнө Цинь улс хойд зүгийн хэрмүүдийг холбосон."
  },
  {
   "scene": "ic",
   "zh": "长城上有城墙、烽火台和关口。",
   "mn": "Хэрэм дээр хана, гэрлэн дохионы цамхаг, хаалга бий."
  },
  {
   "scene": "ic",
   "zh": "士兵在这里保护北方的家园。",
   "mn": "Цэргүүд энд хойд нутгаа хамгаалдаг байв."
  },
  {
   "scene": "t2",
   "zh": "后来的明朝又修了很多年。",
   "mn": "Хожим Мин улс дахин олон жил засч барьсан."
  },
  {
   "scene": "t2",
   "zh": "1987年，长城成为世界文化遗产。",
   "mn": "1987 онд Цагаан хэрэм дэлхийн соёлын өвд бүртгэгдсэн."
  },
  {
   "scene": "t3",
   "zh": "今天，每年有很多人来这里旅行。",
   "mn": "Өнөөдөр жил бүр олон хүн энд аялахаар ирдэг."
  }
 ],
