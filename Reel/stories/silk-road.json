 "title_zh": "丝绸之路",
 "title_mn": "Торгоны зам",
 "lines": [
  {
   "scene": "t1",
   "zh": "两千多年前，汉朝的张骞去了西方。",
   "mn": "Хоёр мянга гаруй жилийн өмнө Хань улсын Жан Цянь баруун зүгт очсон."
  },
  {
   "scene": "t1",
   "zh": "他走过的路，后来叫“丝绸之路”。",
   "mn": "Түүний туулсан замыг хожим «Торгоны зам» гэж нэрлэсэн."
  },
  {
   "scene": "t1",
   "zh": "这条路上有沙漠，也有高山。",
   "mn": "Энэ замд элсэн цөл ч, өндөр уул ч байсан."
  },
  {
   "scene": "ic",
   "zh": "商人把丝绸和瓷器带到西方，",
   "mn": "Худалдаачид торго, шаазан эдийг баруун зүгт авч явж,"
  },
  {
   "scene": "ic",
   "zh": "也把香料带回中国。",
   "mn": "амтлагчийг Хятадад авчирсан."
  },
  {
   "scene": "t3",
   "zh": "骆驼是沙漠里最好的朋友。",
   "mn": "Тэмээ бол элсэн цөлийн хамгийн сайн нөхөр."
  },
  {
   "scene": "t2",
   "zh": "路上的人交换货物，也交换文化。",
   "mn": "Замын хүмүүс бараа бүтээгдэхүүн төдийгүй соёлоо солилцсон."
  }
 ],
