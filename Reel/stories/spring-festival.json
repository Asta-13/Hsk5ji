 "title_zh": "春节",
 "title_mn": "Хаврын баяр (Сарын шинэ)",
 "lines": [
  {
   "scene": "t1",
   "zh": "春节是中国最重要的传统节日。",
   "mn": "Хаврын баяр бол Хятадын хамгийн чухал уламжлалт баяр."
  },
  {
   "scene": "t1",
   "zh": "它在农历正月初一，也叫“过年”。",
   "mn": "Энэ нь сарны тооллын нэгдүгээр сарын 1-нд болдог бөгөөд «гуо нянь» гэж бас нэрлэдэг."
  },
  {
   "scene": "ic",
   "zh": "大家一起吃饺子，家人团聚。",
   "mn": "Бүгд хамт банш идэж, гэр бүл эргэн нийлдэг."
  },
  {
   "scene": "ic",
   "zh": "大人给孩子红包，祝他们健康。",
   "mn": "Томчууд хүүхдэд улаан дугтуй өгч, эрүүл энх байхыг ерөөдөг."
  },
  {
   "scene": "ic",
   "zh": "家家户户贴红色的“福”字。",
   "mn": "Айл бүр улаан «Фү» тэмдэгт наадаг."
  },
  {
   "scene": "t2",
   "zh": "晚上，全家一起看春节晚会。",
   "mn": "Орой бүх гэр бүл хамтдаа Хаврын баярын тоглолтыг үздэг."
  },
  {
   "scene": "t2",
   "zh": "祝你新年快乐！",
   "mn": "Шинэ жилийн мэнд хүргэе!"
  }
 ],
